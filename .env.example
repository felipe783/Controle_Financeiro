# Copie para .env (o scripts/install.sh faz isso e gera as senhas). Nunca versione o .env real.

# ---------- Aplicação ----------
APP_ENV=production
# Porta publicada no host (servidor) -> Nginx interno (8080).
APP_PORT=8080
# 0.0.0.0 = aceita conexões da rede; 127.0.0.1 = somente a própria máquina.
APP_BIND=0.0.0.0
APP_TIMEZONE=America/Sao_Paulo
LOG_LEVEL=INFO

# ---------- Banco de dados (PostgreSQL) ----------
POSTGRES_DB=financeiro
# Usuário da aplicação (sem privilégios de superusuário; dono do banco).
POSTGRES_USER=financeiro_app
# Obrigatórias. Gere com: openssl rand -hex 24  (o install.sh gera automaticamente)
POSTGRES_PASSWORD=
# Senha do superusuário "postgres" (só administração; não é repassada à aplicação).
POSTGRES_SUPERUSER_PASSWORD=
# As senhas acima só valem na CRIAÇÃO do volume. Trocá-las depois exige ALTER ROLE (ver README).

# ---------- Sessão / acesso ----------
# true quando o acesso for por HTTPS (cookie só trafega cifrado).
COOKIE_SECURE=false
SESSION_HOURS=12
# Vazio = mesma origem (padrão, via Nginx). Só preencha para um frontend em outro domínio.
CORS_ORIGINS=

# ---------- Cotações ----------
QUOTES_AUTO_UPDATE=true
QUOTES_UPDATE_INTERVAL_MINUTES=60
QUOTES_REQUEST_TIMEOUT_SECONDS=15
QUOTES_MAX_RETRIES=2
QUOTES_MIN_SECONDS_BETWEEN_REQUESTS=1
# Dias sem atualização para marcar a cotação como desatualizada (bolsa / demais).
QUOTES_STALE_DAYS_LISTED=4
QUOTES_STALE_DAYS_OTHER=35
# brapi.dev (ações, FIIs e ETFs da B3). Opcional: sem token, use cotações manuais.
BRAPI_TOKEN=
# Alpha Vantage (ativos internacionais). Opcional.
ALPHAVANTAGE_API_KEY=
ALPHAVANTAGE_DAILY_LIMIT=25
# Câmbio PTAX do Banco Central (público, sem chave).
FX_BCB_ENABLED=true

# ---------- Planejamento ----------
BUDGET_ALERT_PERCENT=80

# ---------- Backup ----------
# Dias de retenção dos arquivos em backups/ (0 = nunca remover automaticamente).
BACKUP_RETENTION_DAYS=30
